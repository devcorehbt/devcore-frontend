{
  "name": "devcore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "bun run build && lhci autorun",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@lhci/cli": "^0.14.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^19.5.0",
    "@devcore/eslint-config": "workspace:*",
    "eslint": "^9.25.0",
    "lefthook": "^1.10.10",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
